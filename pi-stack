#!/bin/bash

set -e

APP_NAME="Pi Dev Stack CLI"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

OS_ID="unknown"
OS_NAME="unknown"
ARCH="$(uname -m)"
if [ -f /etc/os-release ]; then
  . /etc/os-release
  OS_ID="${ID:-unknown}"
  OS_NAME="${PRETTY_NAME:-unknown}"
fi

DOCKER_CMD="${DOCKER_CMD:-docker}"
if ! $DOCKER_CMD ps >/dev/null 2>&1; then
  if sudo docker ps >/dev/null 2>&1; then
    DOCKER_CMD="sudo docker"
  fi
fi

line() { echo "======================================="; }
pause() { echo ""; read -rp "Press Enter to continue..." _; }
header() { clear || true; line; echo " $APP_NAME"; line; }
ensure_executable() { chmod +x setup.sh stop.sh tunnel.sh validate.sh pi-stack homelab 2>/dev/null || true; }

is_debian_like() {
  [ "$OS_ID" = "debian" ] || [ "$OS_ID" = "raspbian" ] || [ "$OS_ID" = "ubuntu" ] || grep -qi "debian\|raspbian\|ubuntu" /etc/os-release 2>/dev/null
}

system_info() {
  line
  echo "System Info"
  line
  echo "OS: $OS_NAME"
  echo "OS ID: $OS_ID"
  echo "Architecture: $ARCH"
  echo "Kernel: $(uname -r)"
  echo "User: $USER"
}

install_stack() { ensure_executable; ./setup.sh; }
start_stack() { ensure_executable; $DOCKER_CMD compose up -d; echo "Stack started."; }
stop_stack() { ensure_executable; ./stop.sh; }
restart_stack() { stop_stack; start_stack; }
status_stack() { $DOCKER_CMD compose ps; }
validate_stack() { ensure_executable; DOCKER_CMD="$DOCKER_CMD" ./validate.sh; }
update_repo() { git pull; ensure_executable; }
show_urls() { ./tunnel.sh core urls; }
quick_tunnel() { ensure_executable; ./tunnel.sh "${1:-core}" "${2:-start}"; }

install_remote_desktop() {
  system_info
  echo ""
  echo "Installing Tailscale and VNC remote desktop support..."

  if ! is_debian_like; then
    echo "[FAIL] Automatic desktop install currently supports Debian/Raspberry Pi OS/Ubuntu only."
    echo "Install Tailscale and a VNC server manually for this OS."
    return 1
  fi

  if ! command -v curl >/dev/null 2>&1; then
    sudo apt update
    sudo apt install -y curl
  fi

  if ! command -v tailscale >/dev/null 2>&1; then
    curl -fsSL https://tailscale.com/install.sh | sh
  else
    echo "[OK] Tailscale already installed"
  fi

  sudo apt update

  if sudo apt install -y realvnc-vnc-server realvnc-vnc-viewer; then
    echo "[OK] RealVNC installed"
    sudo systemctl enable vncserver-x11-serviced.service 2>/dev/null || true
    sudo systemctl start vncserver-x11-serviced.service 2>/dev/null || true
  else
    echo "[WARN] RealVNC install failed. Trying TigerVNC fallback..."
    sudo apt install -y tigervnc-standalone-server tigervnc-common || {
      echo "[FAIL] Could not install a VNC server automatically."
      return 1
    }
  fi

  if ! tailscale ip -4 >/dev/null 2>&1; then
    echo "Starting Tailscale login..."
    sudo tailscale up || {
      echo "[FAIL] Tailscale login/start failed. Run manually: sudo tailscale up"
      return 1
    }
  fi

  remote_desktop_status
}

remote_desktop_status() {
  line
  echo "Remote Desktop Status"
  line
  echo "OS: $OS_NAME"
  echo "Architecture: $ARCH"
  command -v tailscale >/dev/null 2>&1 && echo "[OK] Tailscale installed" || echo "[FAIL] Tailscale missing"
  command -v vncserver >/dev/null 2>&1 && echo "[OK] VNC command available" || echo "[WARN] vncserver command not found"
  echo ""
  echo "Tailscale IP:"
  TS_IP=$(tailscale ip -4 2>/dev/null | head -n 1 || true)
  [ -n "$TS_IP" ] && echo "$TS_IP" || echo "Tailscale is not connected"
  echo ""
  echo "VNC port check:"
  if sudo ss -tulpn 2>/dev/null | grep -q ':5900'; then
    sudo ss -tulpn | grep ':5900'
    echo "[OK] VNC is listening on port 5900"
  else
    echo "[FAIL] Nothing is listening on VNC port 5900"
    echo "Try: sudo raspi-config -> Interface Options -> VNC -> Enable"
  fi
  echo ""
  echo "Connect from your laptop VNC Viewer to:"
  [ -n "$TS_IP" ] && echo "$TS_IP:5900" || echo "<tailscale-ip>:5900"
}

open_kicad_hint() {
  echo "For remote KiCad:"
  echo "1) Run: homelab desktop-install"
  echo "2) Run: homelab desktop-status"
  echo "3) Connect VNC Viewer to the Tailscale IP on port 5900"
  echo "4) Open KiCad inside the Raspberry Pi desktop"
  echo ""
  echo "Do not use homelab tunnel desktop on Raspberry Pi ARM64 until a supported browser desktop backend is configured."
}

logs_menu() { $DOCKER_CMD compose logs -f; }

doctor() {
  system_info
  echo ""
  command -v docker >/dev/null 2>&1 && echo "[OK] docker installed" || echo "[FAIL] docker missing"
  $DOCKER_CMD ps >/dev/null 2>&1 && echo "[OK] docker accessible" || echo "[FAIL] docker not accessible"
  $DOCKER_CMD compose version >/dev/null 2>&1 && echo "[OK] docker compose available" || echo "[FAIL] docker compose missing"
  command -v cloudflared >/dev/null 2>&1 && echo "[OK] cloudflared installed" || echo "[WARN] cloudflared missing"
  command -v tailscale >/dev/null 2>&1 && echo "[OK] tailscale installed" || echo "[WARN] tailscale missing"
  [ -f .env ] && echo "[OK] .env exists" || echo "[WARN] .env missing"
  [ -d data ] && echo "[OK] data directory exists" || echo "[WARN] data directory missing"
  echo ""; echo "Disk:"; df -h . || true
  echo ""; echo "Memory:"; free -h || true
  echo ""; echo "Temperature:"; if command -v vcgencmd >/dev/null 2>&1; then vcgencmd measure_temp || true; else echo "vcgencmd not available"; fi
  echo ""; echo "Compose config:"; $DOCKER_CMD compose config >/dev/null 2>&1 && echo "[OK] compose config valid" || echo "[FAIL] compose config invalid"
  echo ""; echo "Containers:"; $DOCKER_CMD compose ps || true
  echo ""; echo "Remote desktop:"; remote_desktop_status || true
}

dashboard() {
  while true; do
    clear || true
    line; echo "Homelab Dashboard"; line; date
    echo ""; echo "System: $OS_NAME / $ARCH"
    echo ""; echo "Containers:"; $DOCKER_CMD compose ps || true
    echo ""; echo "Memory:"; free -h | sed -n '1,2p' || true
    echo ""; echo "Disk:"; df -h . | tail -n 1 || true
    echo ""; echo "Tailscale:"; tailscale ip -4 2>/dev/null || echo "Tailscale not connected"
    echo ""; echo "Tunnel URLs:"; ./tunnel.sh core urls || true
    echo ""; echo "Press Ctrl+C to exit. Refreshing every 5 seconds."
    sleep 5
  done
}

models_menu() {
  header
  echo "Ollama Model Manager"
  echo "1) List models"
  echo "2) Pull llama3.2:1b"
  echo "3) Pull llama3.2:3b"
  echo "4) Pull qwen2.5:3b"
  echo "5) Pull custom model"
  echo "0) Back"
  read -rp "Select: " choice
  case "$choice" in
    1) curl -s http://127.0.0.1:11434/api/tags || true; pause ;;
    2) $DOCKER_CMD exec pi-ollama ollama pull llama3.2:1b; pause ;;
    3) $DOCKER_CMD exec pi-ollama ollama pull llama3.2:3b; pause ;;
    4) $DOCKER_CMD exec pi-ollama ollama pull qwen2.5:3b; pause ;;
    5) read -rp "Model name: " model; $DOCKER_CMD exec pi-ollama ollama pull "$model"; pause ;;
    0) return ;;
    *) echo "Invalid choice"; pause ;;
  esac
}

backup_stack() { mkdir -p backups; FILE="backups/pi-dev-stack-$(date +%Y%m%d-%H%M%S).tar.gz"; tar -czf "$FILE" data .env homepage cloudflared local docker-compose.override.yml 2>/dev/null || true; echo "Backup created: $FILE"; }
restore_stack() { file="${1:-}"; if [ -z "$file" ]; then ls -1 backups/*.tar.gz 2>/dev/null || { echo "No backups found."; return 1; }; read -rp "Backup file to restore: " file; fi; [ -f "$file" ] || { echo "Backup not found: $file"; return 1; }; ./stop.sh || true; tar -xzf "$file"; echo "Restore complete. Run: ./homelab start"; }
install_global() { chmod +x homelab pi-stack; sudo ln -sf "$ROOT_DIR/homelab" /usr/local/bin/homelab; echo "Installed global command: homelab"; }
configure_named_tunnel() { echo "Use Cloudflare named tunnel setup from README."; }
start_named_tunnel() { [ -f local/start-named-tunnel.sh ] || { echo "Run: homelab configure-named-tunnel"; return 1; }; ./local/start-named-tunnel.sh; }
reset_stack() { echo "WARNING: This removes containers, volumes, local data and logs."; read -rp "Type RESET to continue: " confirm; [ "$confirm" = "RESET" ] && ./stop.sh --wipe-data || echo "Reset cancelled."; }

menu() {
  while true; do
    header
    echo "1) Install / setup full stack"
    echo "2) Start stack"
    echo "3) Stop stack"
    echo "4) Restart stack"
    echo "5) Show status"
    echo "6) View logs"
    echo "7) Doctor checks"
    echo "8) Terminal dashboard"
    echo "9) Ollama models"
    echo "10) Start quick Cloudflare tunnel"
    echo "11) Show public URLs"
    echo "12) Backup stack data"
    echo "13) Restore backup"
    echo "14) Validate stack"
    echo "15) Update repo"
    echo "16) Install global homelab command"
    echo "17) Full reset / wipe data"
    echo "18) Install Tailscale + VNC remote desktop"
    echo "19) Show remote desktop status"
    echo "20) KiCad remote access help"
    echo "21) System info"
    echo "0) Exit"
    read -rp "Select option: " choice
    case "$choice" in
      1) install_stack; pause ;; 2) start_stack; pause ;; 3) stop_stack; pause ;; 4) restart_stack; pause ;; 5) status_stack; pause ;; 6) logs_menu ;; 7) doctor; pause ;; 8) dashboard ;; 9) models_menu ;; 10) quick_tunnel core start; pause ;; 11) show_urls; pause ;; 12) backup_stack; pause ;; 13) restore_stack; pause ;; 14) validate_stack; pause ;; 15) update_repo; pause ;; 16) install_global; pause ;; 17) reset_stack; pause ;; 18) install_remote_desktop; pause ;; 19) remote_desktop_status; pause ;; 20) open_kicad_hint; pause ;; 21) system_info; pause ;; 0) exit 0 ;; *) echo "Invalid option"; pause ;;
    esac
  done
}

case "${1:-menu}" in
  menu) menu ;; install) install_stack ;; start) start_stack ;; stop) stop_stack ;; restart) restart_stack ;; status) status_stack ;; logs) $DOCKER_CMD compose logs -f ;; doctor) doctor ;; dashboard) dashboard ;; models) models_menu ;; tunnel) shift; quick_tunnel "${1:-core}" "${2:-start}" ;; urls) show_urls ;; configure-named-tunnel) configure_named_tunnel ;; named-tunnel) start_named_tunnel ;; backup) backup_stack ;; restore) restore_stack "${2:-}" ;; validate) validate_stack ;; update) update_repo ;; install-global) install_global ;; reset) reset_stack ;; desktop-install) install_remote_desktop ;; desktop-status) remote_desktop_status ;; kicad) open_kicad_hint ;; system-info) system_info ;; *) echo "Usage: homelab [menu|install|start|stop|restart|status|logs|doctor|dashboard|models|tunnel|urls|backup|restore|validate|update|install-global|reset|desktop-install|desktop-status|kicad|system-info]"; exit 1 ;;
esac
