#!/bin/bash

set -e

APP_NAME="Pi Dev Stack CLI"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

DOCKER_CMD="${DOCKER_CMD:-docker}"
if ! $DOCKER_CMD ps >/dev/null 2>&1; then
  if sudo docker ps >/dev/null 2>&1; then
    DOCKER_CMD="sudo docker"
  fi
fi

line() { echo "======================================="; }
pause() { echo ""; read -rp "Press Enter to continue..." _; }
header() { clear || true; line; echo " $APP_NAME"; line; }
ensure_executable() { chmod +x setup.sh stop.sh tunnel.sh validate.sh pi-stack homelab 2>/dev/null || true; }

install_stack() { ensure_executable; ./setup.sh; }
start_stack() { ensure_executable; $DOCKER_CMD compose up -d; echo "Stack started."; }
stop_stack() { ensure_executable; ./stop.sh; }
restart_stack() { stop_stack; start_stack; }
status_stack() { $DOCKER_CMD compose ps; }
validate_stack() { ensure_executable; DOCKER_CMD="$DOCKER_CMD" ./validate.sh; }
update_repo() { git pull; ensure_executable; }

show_urls() {
  echo "Saved/generated public URLs:"
  grep -R "trycloudflare.com" logs/ 2>/dev/null || echo "No tunnel URLs found yet. Start quick tunnel first."
}

quick_tunnel() { ensure_executable; ./tunnel.sh; }

logs_menu() {
  header
  echo "Choose logs:"
  echo "1) All services"
  echo "2) n8n"
  echo "3) Open WebUI"
  echo "4) Ollama"
  echo "5) Portainer"
  echo "6) Dozzle"
  echo "7) Uptime Kuma"
  echo "0) Back"
  read -rp "Select: " choice
  case "$choice" in
    1) $DOCKER_CMD compose logs -f ;;
    2) $DOCKER_CMD compose logs -f n8n ;;
    3) $DOCKER_CMD compose logs -f open-webui ;;
    4) $DOCKER_CMD compose logs -f ollama ;;
    5) $DOCKER_CMD compose logs -f portainer ;;
    6) $DOCKER_CMD compose logs -f dozzle ;;
    7) $DOCKER_CMD compose logs -f uptime-kuma ;;
    0) return ;;
    *) echo "Invalid choice"; pause ;;
  esac
}

doctor() {
  line
  echo "Homelab Doctor"
  line

  command -v docker >/dev/null 2>&1 && echo "[OK] docker installed" || echo "[FAIL] docker missing"
  $DOCKER_CMD ps >/dev/null 2>&1 && echo "[OK] docker accessible" || echo "[FAIL] docker not accessible"
  $DOCKER_CMD compose version >/dev/null 2>&1 && echo "[OK] docker compose available" || echo "[FAIL] docker compose missing"
  command -v cloudflared >/dev/null 2>&1 && echo "[OK] cloudflared installed" || echo "[WARN] cloudflared missing"
  [ -f .env ] && echo "[OK] .env exists" || echo "[WARN] .env missing"
  [ -d data ] && echo "[OK] data directory exists" || echo "[WARN] data directory missing"

  echo ""
  echo "Disk:"
  df -h . || true

  echo ""
  echo "Memory:"
  free -h || true

  echo ""
  echo "Temperature:"
  if command -v vcgencmd >/dev/null 2>&1; then
    vcgencmd measure_temp || true
  else
    echo "vcgencmd not available"
  fi

  echo ""
  echo "Compose config:"
  $DOCKER_CMD compose config >/dev/null 2>&1 && echo "[OK] compose config valid" || echo "[FAIL] compose config invalid"

  echo ""
  echo "Containers:"
  $DOCKER_CMD compose ps || true

  echo ""
  echo "n8n webhook URL:"
  grep '^N8N_WEBHOOK_URL=' .env 2>/dev/null || echo "Not set"
}

dashboard() {
  while true; do
    clear || true
    line
    echo "Homelab Dashboard"
    line
    date
    echo ""
    echo "Containers:"
    $DOCKER_CMD compose ps || true
    echo ""
    echo "System:"
    free -h | sed -n '1,2p' || true
    df -h . | tail -n 1 || true
    if command -v vcgencmd >/dev/null 2>&1; then vcgencmd measure_temp || true; fi
    echo ""
    echo "URLs:"
    grep -R "trycloudflare.com" logs/ 2>/dev/null || echo "No quick tunnel URLs found"
    echo ""
    echo "Press Ctrl+C to exit. Refreshing every 5 seconds."
    sleep 5
  done
}

models_menu() {
  header
  echo "Ollama Model Manager"
  echo "1) List models"
  echo "2) Pull llama3.2:1b"
  echo "3) Pull llama3.2:3b"
  echo "4) Pull qwen2.5:3b"
  echo "5) Pull custom model"
  echo "0) Back"
  read -rp "Select: " choice
  case "$choice" in
    1) curl -s http://127.0.0.1:11434/api/tags || true; pause ;;
    2) $DOCKER_CMD exec pi-ollama ollama pull llama3.2:1b; pause ;;
    3) $DOCKER_CMD exec pi-ollama ollama pull llama3.2:3b; pause ;;
    4) $DOCKER_CMD exec pi-ollama ollama pull qwen2.5:3b; pause ;;
    5) read -rp "Model name: " model; $DOCKER_CMD exec pi-ollama ollama pull "$model"; pause ;;
    0) return ;;
    *) echo "Invalid choice"; pause ;;
  esac
}

backup_stack() {
  mkdir -p backups
  FILE="backups/pi-dev-stack-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$FILE" data .env homepage cloudflared local docker-compose.override.yml 2>/dev/null || true
  echo "Backup created: $FILE"
}

restore_stack() {
  file="${1:-}"
  if [ -z "$file" ]; then
    ls -1 backups/*.tar.gz 2>/dev/null || { echo "No backups found."; return 1; }
    read -rp "Backup file to restore: " file
  fi
  [ -f "$file" ] || { echo "Backup not found: $file"; return 1; }
  echo "Stopping stack before restore..."
  ./stop.sh || true
  tar -xzf "$file"
  echo "Restore complete. Run: ./homelab start"
}

install_global() {
  chmod +x homelab pi-stack
  sudo ln -sf "$ROOT_DIR/homelab" /usr/local/bin/homelab
  echo "Installed global command: homelab"
}

configure_named_tunnel() {
  mkdir -p cloudflared local
  echo "Stable Cloudflare named tunnel wizard"
  read -rp "Tunnel name [pi-dev-stack]: " tunnel_name
  tunnel_name="${tunnel_name:-pi-dev-stack}"
  cloudflared tunnel login || true
  cloudflared tunnel create "$tunnel_name" || true
  read -rp "Tunnel ID: " tunnel_id
  read -rp "Base domain, e.g. example.com: " base_domain
  N8N_HOST="n8n.$base_domain"
  AI_HOST="ai.$base_domain"
  PORTAINER_HOST="portainer.$base_domain"
  LOGS_HOST="logs.$base_domain"
  STATUS_HOST="status.$base_domain"
  cloudflared tunnel route dns "$tunnel_name" "$N8N_HOST" || true
  cloudflared tunnel route dns "$tunnel_name" "$AI_HOST" || true
  cloudflared tunnel route dns "$tunnel_name" "$PORTAINER_HOST" || true
  cloudflared tunnel route dns "$tunnel_name" "$LOGS_HOST" || true
  cloudflared tunnel route dns "$tunnel_name" "$STATUS_HOST" || true
  cat > cloudflared/config.yml <<EOF
 tunnel: $tunnel_id
 credentials-file: /home/$USER/.cloudflared/$tunnel_id.json

 ingress:
   - hostname: $N8N_HOST
     service: http://localhost:5678
   - hostname: $AI_HOST
     service: http://localhost:3000
   - hostname: $PORTAINER_HOST
     service: http://localhost:9000
   - hostname: $LOGS_HOST
     service: http://localhost:9999
   - hostname: $STATUS_HOST
     service: http://localhost:3001
   - service: http_status:404
EOF
  cat > local/start-named-tunnel.sh <<EOF
#!/bin/bash
cloudflared tunnel --config cloudflared/config.yml run
EOF
  chmod +x local/start-named-tunnel.sh
  if grep -q '^N8N_WEBHOOK_URL=' .env 2>/dev/null; then
    sed -i "s|^N8N_WEBHOOK_URL=.*|N8N_WEBHOOK_URL=https://$N8N_HOST/|" .env
  else
    echo "N8N_WEBHOOK_URL=https://$N8N_HOST/" >> .env
  fi
  echo "Named tunnel configured. n8n: https://$N8N_HOST"
}

start_named_tunnel() {
  [ -f local/start-named-tunnel.sh ] || { echo "Run: homelab configure-named-tunnel"; return 1; }
  ./local/start-named-tunnel.sh
}

reset_stack() {
  echo "WARNING: This removes containers, volumes, local data and logs."
  read -rp "Type RESET to continue: " confirm
  [ "$confirm" = "RESET" ] && ./stop.sh --wipe-data || echo "Reset cancelled."
}

menu() {
  while true; do
    header
    echo "1) Install / setup full stack"
    echo "2) Start stack"
    echo "3) Stop stack"
    echo "4) Restart stack"
    echo "5) Show status"
    echo "6) View logs"
    echo "7) Doctor checks"
    echo "8) Terminal dashboard"
    echo "9) Ollama models"
    echo "10) Start quick Cloudflare tunnel"
    echo "11) Show public URLs"
    echo "12) Configure stable named tunnel"
    echo "13) Start stable named tunnel"
    echo "14) Backup stack data"
    echo "15) Restore backup"
    echo "16) Validate stack"
    echo "17) Update repo"
    echo "18) Install global homelab command"
    echo "19) Full reset / wipe data"
    echo "0) Exit"
    read -rp "Select option: " choice
    case "$choice" in
      1) install_stack; pause ;;
      2) start_stack; pause ;;
      3) stop_stack; pause ;;
      4) restart_stack; pause ;;
      5) status_stack; pause ;;
      6) logs_menu ;;
      7) doctor; pause ;;
      8) dashboard ;;
      9) models_menu ;;
      10) quick_tunnel; pause ;;
      11) show_urls; pause ;;
      12) configure_named_tunnel; pause ;;
      13) start_named_tunnel; pause ;;
      14) backup_stack; pause ;;
      15) restore_stack; pause ;;
      16) validate_stack; pause ;;
      17) update_repo; pause ;;
      18) install_global; pause ;;
      19) reset_stack; pause ;;
      0) exit 0 ;;
      *) echo "Invalid option"; pause ;;
    esac
  done
}

case "${1:-menu}" in
  menu) menu ;;
  install) install_stack ;;
  start) start_stack ;;
  stop) stop_stack ;;
  restart) restart_stack ;;
  status) status_stack ;;
  logs) $DOCKER_CMD compose logs -f ;;
  doctor) doctor ;;
  dashboard) dashboard ;;
  models) models_menu ;;
  tunnel) quick_tunnel ;;
  urls) show_urls ;;
  configure-named-tunnel) configure_named_tunnel ;;
  named-tunnel) start_named_tunnel ;;
  backup) backup_stack ;;
  restore) restore_stack "${2:-}" ;;
  validate) validate_stack ;;
  update) update_repo ;;
  install-global) install_global ;;
  reset) reset_stack ;;
  *) echo "Usage: homelab [menu|install|start|stop|restart|status|logs|doctor|dashboard|models|tunnel|urls|configure-named-tunnel|named-tunnel|backup|restore|validate|update|install-global|reset]"; exit 1 ;;
esac
