#!/bin/bash

set -e

APP_NAME="Pi Dev Stack CLI"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

OUTPUT_FORMAT="text"
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --json) OUTPUT_FORMAT="json" ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

OS_ID="unknown"
OS_NAME="unknown"
ARCH="$(uname -m)"
if [ -f /etc/os-release ]; then
  . /etc/os-release
  OS_ID="${ID:-unknown}"
  OS_NAME="${PRETTY_NAME:-unknown}"
fi

DOCKER_CMD="${DOCKER_CMD:-docker}"
if ! $DOCKER_CMD ps >/dev/null 2>&1; then
  if sudo docker ps >/dev/null 2>&1; then
    DOCKER_CMD="sudo docker"
  fi
fi

SERVICES="postgres redis n8n ollama open-webui portainer dozzle uptime-kuma homepage glances home-assistant pihole"

line() { echo "======================================="; }
pause() { echo ""; read -rp "Press Enter to continue..." _; }
header() { clear || true; line; echo " $APP_NAME"; line; }
ensure_executable() { chmod +x setup.sh stop.sh tunnel.sh validate.sh pi-stack homelab 2>/dev/null || true; }
is_json() { [ "$OUTPUT_FORMAT" = "json" ]; }
json_string() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().rstrip("\n")))'; }
json_bool_cmd() { "$@" >/dev/null 2>&1 && printf 'true' || printf 'false'; }

is_debian_like() { [ "$OS_ID" = "debian" ] || [ "$OS_ID" = "raspbian" ] || [ "$OS_ID" = "ubuntu" ] || grep -qi "debian\|raspbian\|ubuntu" /etc/os-release 2>/dev/null; }
container_name() { echo "pi-$1"; }

system_info() { echo "OS: $OS_NAME"; }
install_stack() { ensure_executable; ./setup.sh; }
start_stack() { ensure_executable; $DOCKER_CMD compose up -d; echo "Stack started."; }
stop_stack() { ensure_executable; ./stop.sh; }
restart_stack() { stop_stack; start_stack; }
status_stack() { $DOCKER_CMD compose ps; }
validate_stack() { ensure_executable; DOCKER_CMD="$DOCKER_CMD" ./validate.sh; }
update_repo() { git pull; ensure_executable; }
show_urls() { ./tunnel.sh core urls; }
quick_tunnel() { ensure_executable; ./tunnel.sh "${1:-core}" "${2:-start}"; }

service_cmd() {
  action="${1:-list}"
  service="${2:-}"
  case "$action" in
    list) echo "$SERVICES" | tr ' ' '\n' ;;
    start) [ -n "$service" ] || { echo "Usage: homelab service start <service>"; return 1; }; $DOCKER_CMD compose up -d "$service" ;;
    stop) [ -n "$service" ] || { echo "Usage: homelab service stop <service>"; return 1; }; $DOCKER_CMD compose stop "$service" ;;
    restart) [ -n "$service" ] || { echo "Usage: homelab service restart <service>"; return 1; }; $DOCKER_CMD compose restart "$service" ;;
    logs) [ -n "$service" ] || { echo "Usage: homelab service logs <service>"; return 1; }; $DOCKER_CMD compose logs -f "$service" ;;
    inspect) [ -n "$service" ] || { echo "Usage: homelab service inspect <service>"; return 1; }; $DOCKER_CMD inspect "$(container_name "$service")" ;;
    shell) [ -n "$service" ] || { echo "Usage: homelab service shell <service>"; return 1; }; $DOCKER_CMD exec -it "$(container_name "$service")" sh ;;
    *) echo "Usage: homelab service <list|start|stop|restart|logs|inspect|shell> [service]"; return 1 ;;
  esac
}

pihole_cmd() {
  action="${1:-status}"
  case "$action" in
    start) service_cmd start pihole ;;
    stop) service_cmd stop pihole ;;
    restart) service_cmd restart pihole ;;
    logs) service_cmd logs pihole ;;
    status) $DOCKER_CMD compose ps pihole ;;
    shell) $DOCKER_CMD exec -it pi-pihole bash ;;
    url)
      echo "Pi-hole Admin URL: http://localhost:8081/admin"
      echo "Default DNS Port: 53"
      ;;
    enable)
      domain="${2:-}"
      [ -n "$domain" ] || { echo "Usage: homelab pihole enable <domain>"; return 1; }
      $DOCKER_CMD exec pi-pihole pihole whitelist "$domain"
      ;;
    block)
      domain="${2:-}"
      [ -n "$domain" ] || { echo "Usage: homelab pihole block <domain>"; return 1; }
      $DOCKER_CMD exec pi-pihole pihole blacklist "$domain"
      ;;
    disable)
      seconds="${2:-60}"
      $DOCKER_CMD exec pi-pihole pihole disable "$seconds"
      ;;
    enable-blocking)
      $DOCKER_CMD exec pi-pihole pihole enable
      ;;
    update-gravity)
      $DOCKER_CMD exec pi-pihole pihole -g
      ;;
    stats)
      $DOCKER_CMD exec pi-pihole pihole -c || true
      ;;
    password)
      pass="${2:-}"
      [ -n "$pass" ] || { echo "Usage: homelab pihole password <new-password>"; return 1; }
      $DOCKER_CMD exec pi-pihole pihole setpassword "$pass"
      ;;
    *)
      echo "Usage: homelab pihole <start|stop|restart|logs|status|shell|url|enable|block|disable|enable-blocking|update-gravity|stats|password>"
      return 1
      ;;
  esac
}

logs_menu() { $DOCKER_CMD compose logs -f; }
doctor() { system_info; }
dashboard() { $DOCKER_CMD compose ps; }
backup_stack() { mkdir -p backups; FILE="backups/pi-dev-stack-$(date +%Y%m%d-%H%M%S).tar.gz"; tar -czf "$FILE" data .env homepage cloudflared local docker-compose.override.yml 2>/dev/null || true; echo "Backup created: $FILE"; }
restore_stack() { echo "Restore not implemented in slim mode"; }
install_global() { chmod +x homelab pi-stack; sudo ln -sf "$ROOT_DIR/homelab" /usr/local/bin/homelab; echo "Installed global command: homelab"; }
reset_stack() { echo "Reset cancelled."; }
menu() { header; echo "Use commands like: homelab pihole status"; }

case "${1:-menu}" in
  menu) menu ;;
  install|up) install_stack ;;
  start) start_stack ;;
  stop|down) stop_stack ;;
  restart) restart_stack ;;
  status|ps) status_stack ;;
  logs) shift; [ -n "${1:-}" ] && service_cmd logs "$1" || $DOCKER_CMD compose logs -f ;;
  doctor) doctor ;;
  dashboard) dashboard ;;
  service) shift; service_cmd "${1:-list}" "${2:-}" ;;
  pihole) shift; pihole_cmd "${1:-status}" "${2:-}" ;;
  tunnel) shift; quick_tunnel "${1:-core}" "${2:-start}" ;;
  urls) show_urls ;;
  backup) backup_stack ;;
  validate) validate_stack ;;
  update) update_repo ;;
  install-global) install_global ;;
  *) echo "Usage: homelab [start|stop|restart|status|doctor|service|pihole]"; exit 1 ;;
esac
