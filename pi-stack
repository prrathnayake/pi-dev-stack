#!/bin/bash

set -e

APP_NAME="Pi Dev Stack CLI"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

OUTPUT_FORMAT="text"
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --json) OUTPUT_FORMAT="json" ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

OS_ID="unknown"
OS_NAME="unknown"
ARCH="$(uname -m)"
if [ -f /etc/os-release ]; then
  . /etc/os-release
  OS_ID="${ID:-unknown}"
  OS_NAME="${PRETTY_NAME:-unknown}"
fi

DOCKER_CMD="${DOCKER_CMD:-docker}"
if ! $DOCKER_CMD ps >/dev/null 2>&1; then
  if sudo docker ps >/dev/null 2>&1; then
    DOCKER_CMD="sudo docker"
  fi
fi

CORE_SERVICES="postgres redis n8n ollama open-webui portainer dozzle uptime-kuma homepage glances home-assistant pihole"
EXTRA_SERVICES="watchtower traefik vaultwarden gitea minio syncthing filebrowser netdata prometheus grafana mosquitto nodered code-server plex dockge"
SERVICES="$CORE_SERVICES $EXTRA_SERVICES"
LOCAL_CLI_DIR="${LOCAL_CLI_DIR:-local/cli.d}"

line() { echo "======================================="; }
header() { clear || true; line; echo " $APP_NAME"; line; }
ensure_executable() { chmod +x setup.sh stop.sh tunnel.sh validate.sh pi-stack homelab 2>/dev/null || true; }
is_service() { echo " $SERVICES " | grep -q " $1 "; }
is_extra_service() { echo " $EXTRA_SERVICES " | grep -q " $1 "; }
compose_for_service() { if is_extra_service "$1"; then echo "$DOCKER_CMD compose --profile extras"; else echo "$DOCKER_CMD compose"; fi; }
container_name() { echo "pi-$1"; }

load_local_cli_extensions() {
  [ -d "$LOCAL_CLI_DIR" ] || return 0
  for file in "$LOCAL_CLI_DIR"/*.sh; do
    [ -f "$file" ] || continue
    . "$file"
  done
}

system_info() { echo "OS: $OS_NAME"; echo "Architecture: $ARCH"; }
install_stack() { ensure_executable; ./setup.sh; }
start_stack() { ensure_executable; $DOCKER_CMD compose up -d; echo "Core stack started."; }
start_all_stack() { ensure_executable; $DOCKER_CMD compose --profile extras up -d; echo "Core + extras stack started."; }
stop_stack() { ensure_executable; ./stop.sh; }
restart_stack() { stop_stack; start_stack; }
status_stack() { $DOCKER_CMD compose --profile extras ps; }
validate_stack() { ensure_executable; DOCKER_CMD="$DOCKER_CMD" ./validate.sh; }
update_repo() { git pull; ensure_executable; }
show_urls() { ./tunnel.sh core urls; }
quick_tunnel() { ensure_executable; ./tunnel.sh "${1:-core}" "${2:-start}"; }

service_cmd() {
  action="${1:-list}"
  service="${2:-}"
  compose="$DOCKER_CMD compose"
  [ -n "$service" ] && compose="$(compose_for_service "$service")"

  case "$action" in
    list) echo "$SERVICES" | tr ' ' '\n' ;;
    core) echo "$CORE_SERVICES" | tr ' ' '\n' ;;
    extras) echo "$EXTRA_SERVICES" | tr ' ' '\n' ;;
    start) [ -n "$service" ] || { echo "Usage: homelab service start <service>"; return 1; }; $compose up -d "$service" ;;
    stop) [ -n "$service" ] || { echo "Usage: homelab service stop <service>"; return 1; }; $compose stop "$service" ;;
    restart) [ -n "$service" ] || { echo "Usage: homelab service restart <service>"; return 1; }; $compose restart "$service" ;;
    status|ps) if [ -n "$service" ]; then $compose ps "$service"; else $DOCKER_CMD compose --profile extras ps; fi ;;
    logs) [ -n "$service" ] || { echo "Usage: homelab service logs <service>"; return 1; }; $compose logs -f "$service" ;;
    inspect) [ -n "$service" ] || { echo "Usage: homelab service inspect <service>"; return 1; }; $DOCKER_CMD inspect "$(container_name "$service")" ;;
    shell) [ -n "$service" ] || { echo "Usage: homelab service shell <service>"; return 1; }; $DOCKER_CMD exec -it "$(container_name "$service")" sh ;;
    *) echo "Usage: homelab service <list|core|extras|start|stop|restart|status|logs|inspect|shell> [service]"; return 1 ;;
  esac
}

service_alias_cmd() {
  service="$1"
  action="${2:-status}"
  if ! is_service "$service"; then echo "Unknown service: $service"; echo "Run: homelab service list"; return 1; fi
  case "$action" in
    start|stop|restart|status|ps|logs|inspect|shell) service_cmd "$action" "$service" ;;
    url) service_url "$service" ;;
    *) echo "Usage: homelab $service <start|stop|restart|status|logs|inspect|shell|url>"; return 1 ;;
  esac
}

service_url() {
  case "$1" in
    n8n) echo "n8n: http://localhost:5678" ;;
    ollama) echo "Ollama API: http://localhost:11434" ;;
    open-webui) echo "Open WebUI: http://localhost:3000" ;;
    portainer) echo "Portainer: http://localhost:9000" ;;
    dozzle) echo "Dozzle: http://localhost:9999" ;;
    uptime-kuma) echo "Uptime Kuma: http://localhost:3001" ;;
    homepage) echo "Homepage: http://localhost:8088" ;;
    glances) echo "Glances: http://localhost:61208" ;;
    home-assistant) echo "Home Assistant: http://localhost:8123" ;;
    pihole) echo "Pi-hole Admin: http://localhost:8081/admin" ;;
    traefik) echo "Traefik Dashboard: http://localhost:8082" ;;
    vaultwarden) echo "Vaultwarden: http://localhost:8083" ;;
    gitea) echo "Gitea: http://localhost:3002" ;;
    minio) echo "MinIO Console: http://localhost:9001"; echo "MinIO API: http://localhost:9002" ;;
    syncthing) echo "Syncthing: http://localhost:8384" ;;
    filebrowser) echo "FileBrowser: http://localhost:8084" ;;
    netdata) echo "Netdata: http://localhost:19999" ;;
    prometheus) echo "Prometheus: http://localhost:9090" ;;
    grafana) echo "Grafana: http://localhost:3003" ;;
    mosquitto) echo "Mosquitto MQTT: localhost:1883" ;;
    nodered) echo "Node-RED: http://localhost:1880" ;;
    code-server) echo "Code Server: https://localhost:8443" ;;
    plex) echo "Plex: http://localhost:32400/web" ;;
    dockge) echo "Dockge: http://localhost:5001" ;;
    postgres) echo "PostgreSQL: localhost:5432 inside Docker network unless exposed" ;;
    redis) echo "Redis: localhost:6379 inside Docker network unless exposed" ;;
    watchtower) echo "Watchtower has no web UI. Use: homelab watchtower logs" ;;
    *) echo "No URL registered for service: $1" ;;
  esac
}

pihole_cmd() {
  action="${1:-status}"
  case "$action" in
    start|stop|restart|status|ps|logs|inspect|shell|url) service_alias_cmd pihole "$action" ;;
    allow|whitelist|enable) domain="${2:-}"; [ -n "$domain" ] || { echo "Usage: homelab pihole allow <domain>"; return 1; }; $DOCKER_CMD exec pi-pihole pihole whitelist "$domain" ;;
    block|blacklist) domain="${2:-}"; [ -n "$domain" ] || { echo "Usage: homelab pihole block <domain>"; return 1; }; $DOCKER_CMD exec pi-pihole pihole blacklist "$domain" ;;
    disable) seconds="${2:-60}"; $DOCKER_CMD exec pi-pihole pihole disable "$seconds" ;;
    enable-blocking) $DOCKER_CMD exec pi-pihole pihole enable ;;
    update-gravity|gravity) $DOCKER_CMD exec pi-pihole pihole -g ;;
    stats) $DOCKER_CMD exec pi-pihole pihole -c || true ;;
    password) pass="${2:-}"; [ -n "$pass" ] || { echo "Usage: homelab pihole password <new-password>"; return 1; }; $DOCKER_CMD exec pi-pihole pihole setpassword "$pass" ;;
    *) echo "Usage: homelab pihole <start|stop|restart|status|logs|shell|url|allow|block|disable|enable-blocking|gravity|stats|password>"; return 1 ;;
  esac
}

doctor() { system_info; echo ""; command -v docker >/dev/null 2>&1 && echo "[OK] docker installed" || echo "[FAIL] docker missing"; $DOCKER_CMD ps >/dev/null 2>&1 && echo "[OK] docker accessible" || echo "[FAIL] docker not accessible"; $DOCKER_CMD compose version >/dev/null 2>&1 && echo "[OK] docker compose available" || echo "[FAIL] docker compose missing"; [ -f .env ] && echo "[OK] .env exists" || echo "[WARN] .env missing"; echo ""; $DOCKER_CMD compose --profile extras ps || true; }
dashboard() { $DOCKER_CMD compose --profile extras ps; }
backup_stack() { mkdir -p backups; FILE="backups/pi-dev-stack-$(date +%Y%m%d-%H%M%S).tar.gz"; tar -czf "$FILE" data .env homepage cloudflared local docker-compose.override.yml 2>/dev/null || true; echo "Backup created: $FILE"; }
install_global() { chmod +x homelab pi-stack; sudo ln -sf "$ROOT_DIR/homelab" /usr/local/bin/homelab; echo "Installed global command: homelab"; }

menu() {
  header
  cat <<EOF
Usage:
  homelab <command>
  homelab <service> <action>

Stack commands:
  homelab start              Start core services
  homelab start-all          Start core + extras services
  homelab stop
  homelab restart
  homelab status
  homelab doctor
  homelab dashboard
  homelab validate
  homelab update
  homelab backup

Service commands:
  homelab service list
  homelab service core
  homelab service extras
  homelab service start <service>
  homelab service stop <service>
  homelab service restart <service>
  homelab service status <service>
  homelab service logs <service>
  homelab service shell <service>

Examples:
  homelab n8n start
  homelab code-server start
  homelab grafana url
  homelab pihole block ads.example.com

Core services:
  $CORE_SERVICES

Extra services:
  $EXTRA_SERVICES
EOF
}

load_local_cli_extensions
cmd="${1:-menu}"
case "$cmd" in
  menu|help|-h|--help) menu ;;
  install|up) install_stack ;;
  start) start_stack ;;
  start-all|extras) start_all_stack ;;
  stop|down) stop_stack ;;
  restart) restart_stack ;;
  status|ps) status_stack ;;
  logs) shift; [ -n "${1:-}" ] && service_cmd logs "$1" || $DOCKER_CMD compose --profile extras logs -f ;;
  doctor) doctor ;;
  dashboard) dashboard ;;
  service) shift; service_cmd "${1:-list}" "${2:-}" ;;
  pihole) shift; pihole_cmd "${1:-status}" "${2:-}" ;;
  tunnel) shift; quick_tunnel "${1:-core}" "${2:-start}" ;;
  urls) show_urls ;;
  backup) backup_stack ;;
  validate) validate_stack ;;
  update) update_repo ;;
  install-global) install_global ;;
  *) if is_service "$cmd"; then shift; service_alias_cmd "$cmd" "${1:-status}"; elif declare -F local_cli_command >/dev/null 2>&1 && local_cli_command "$@"; then exit 0; else echo "Unknown command: $cmd"; echo "Run: homelab help"; exit 1; fi ;;
esac
