{
  "version": 1,
  "stack": {
    "name": "pi-dev-stack",
    "timezone": "Australia/Melbourne"
  },
  "services": {
    "n8n": { "port": 5678, "url": "http://localhost:5678", "tunnel": true, "group": ["core", "automation"] },
    "webui": { "compose_service": "open-webui", "port": 3000, "url": "http://localhost:3000", "tunnel": true, "group": ["core", "ai"] },
    "portainer": { "port": 9000, "url": "http://localhost:9000", "tunnel": true, "group": ["core", "admin"] },
    "homepage": { "port": 8088, "url": "http://localhost:8088", "tunnel": true, "group": ["monitoring", "admin"] },
    "uptime": { "compose_service": "uptime-kuma", "port": 3001, "url": "http://localhost:3001", "tunnel": true, "group": ["monitoring"] },
    "dozzle": { "port": 9999, "url": "http://localhost:9999", "tunnel": true, "group": ["monitoring"] },
    "glances": { "port": 61208, "url": "http://localhost:61208", "tunnel": true, "group": ["monitoring"] },
    "home-assistant": { "port": 8123, "url": "http://localhost:8123", "tunnel": true, "group": ["smart-home"] }
  },
  "tunnel_groups": {
    "core": ["n8n", "webui", "portainer"],
    "monitoring": ["homepage", "uptime", "dozzle", "glances"],
    "smart-home": ["home-assistant"],
    "ai": ["webui"],
    "automation": ["n8n"],
    "all": ["n8n", "webui", "portainer", "homepage", "uptime", "dozzle", "glances", "home-assistant"]
  },
  "remote_desktop": {
    "mode": "tailscale-vnc",
    "vnc_port": 5900,
    "browser_desktop_enabled": false,
    "notes": "On Raspberry Pi ARM64, use Tailscale + VNC Viewer as the stable path."
  }
}
