#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON=${PYTHON:-python3}
VENV="$ROOT_DIR/.homelab-venv"
MARKER="$VENV/.installed"

if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "homelab requires Python 3.11 or newer." >&2
  exit 3
fi

if ! "$PYTHON" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
  echo "homelab requires Python 3.11 or newer." >&2
  exit 3
fi

if [ ! -x "$VENV/bin/python" ]; then
  echo "Creating homelab CLI environment..." >&2
  "$PYTHON" -m venv "$VENV" || {
    echo "Unable to create a virtual environment. Install python3-venv." >&2
    exit 3
  }
fi

if [ ! -f "$MARKER" ] || [ "$ROOT_DIR/pyproject.toml" -nt "$MARKER" ]; then
  echo "Installing homelab CLI dependencies..." >&2
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check --editable "$ROOT_DIR" || exit 3
  touch "$MARKER"
fi

export PI_DEV_STACK_ROOT="$ROOT_DIR"
exec "$VENV/bin/python" -m homelab_cli "$@"
