# Pi Dev Stack environment example
# Copy this file to .env and change all secrets before exposing services.
# .env is ignored by Git and should stay local.

# General
TIMEZONE=Australia/Melbourne
PUBLIC_BASE_URL=http://localhost

# PostgreSQL
POSTGRES_USER=dev
POSTGRES_PASSWORD=change_me_now
POSTGRES_DB=n8n

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change_this_32_char_secret_key

# Open WebUI
WEBUI_SECRET_KEY=change_this_webui_secret

# Pi-hole
PIHOLE_WEBPASSWORD=change_this_pihole_password
PIHOLE_HOSTNAME=pi-hole
PIHOLE_DNS_BIND=0.0.0.0
PIHOLE_WEB_BIND=127.0.0.1
PIHOLE_DNS_LISTENING_MODE=all
PIHOLE_DNS_UPSTREAMS=1.1.1.1;1.0.0.1

# Watchtower
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Traefik
TRAEFIK_HTTP_BIND=127.0.0.1

# Vaultwarden
VAULTWARDEN_DOMAIN=http://localhost:8083
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_ADMIN_TOKEN=change_this_vaultwarden_admin_token

# Gitea
GITEA_ROOT_URL=http://localhost:3002/

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# Code Server
CODE_SERVER_PASSWORD=change_this_code_server_password
